# ---------------------------------------------------------------------------
# Moon-Bird — environment template
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real secrets.
# Only NEXT_PUBLIC_* variables are inlined into the browser bundle; everything
# else stays server-side. See docs/SECURITY.md for the two-client rule.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# `npm run db:start` prints these for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security entirely — it is the whole
# authorization layer. Never prefix with NEXT_PUBLIC_, never import into a
# Client Component. Consumed exclusively by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payout rail (PayPal) -------------------------------------------------
# TODO(operator): create a PayPal REST app and paste live credentials.
# Payouts are stubbed until both values are present; see lib/payout.ts.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# `sandbox` or `live`.
PAYPAL_ENV=sandbox

# Ed25519 key (base64, PKCS#8) used to sign ad/survey completion tokens.
# REQUIRED in production — the signer fails closed if this is unset
# (audit finding A9). Generate one with:
#   node -e "require('node:crypto').generateKeyPair('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'der'}},(e,_,k)=>console.log(k.toString('base64')))"
MOONBIRD_PAYOUT_KEY=

# --- Runtime --------------------------------------------------------------
# `production` enables Secure cookies and disables the dev OTP reveal.
NODE_ENV=development

# Absolute origin used for OTP/magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lunar observer defaults ----------------------------------------------
# Fallback observer position when a user has not set one (Nairobi, Kenya).
NEXT_PUBLIC_DEFAULT_LATITUDE=-1.2921
NEXT_PUBLIC_DEFAULT_LONGITUDE=36.8219

# --- Transactional email --------------------------------------------------
# TODO(operator): replace the Gmail app password that leaked in git history
# (audit finding A9) and point these at a real transactional provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
